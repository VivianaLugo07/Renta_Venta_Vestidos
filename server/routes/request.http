################ DRESSES ################################################
###     recuperar todos
GET http://localhost:9000/api/dresses HTTP/1.1 

###     recuperar por nombre
GET http://localhost:9000/api/dresses/M HTTP/1.1

###     recuperar todos los que se venden
GET http://localhost:9000/api/dresses/option/sevende HTTP/1.1

###     recuperar todos los que se rentan
GET http://localhost:9000/api/dresses/option/serenta HTTP/1.1

###     pantalla de renta por id
GET http://localhost:9000/api/dresses/rental/1 HTTP/1.1

###    pantalla de venta por id
GET http://localhost:9000/api/dresses/sale/1 HTTP/1.1

###     crear nuevo vestido
POST http://localhost:9000/api/dresses HTTP/1.1
Content-Type: application/json

{
    "nombrevestido": "Vestido Elegante",
    "talla": "M",
    "urlimagen": "https://example.com/vestido.jpg",
    "serenta": true,
    "costorenta": 1800.00,
    "sevende": false,
    "costoventa": 0.00
}

###     eliminar vestido por id
DELETE http://localhost:9000/api/dresses/1 HTTP/1.1

###     actualizar vestido por id
PUT http://localhost:9000/api/dresses/1
Content-Type: application/json

{
    "nombrevestido": "Vestido Formal",
    "talla": "S",
    "urlimagen": "https://example.com/vestido.jpg",
    "serenta": false,
    "costorenta": 0.00,
    "sevende": true,
    "costoventa": 5000.00
}


######## Horarios / schedules #############################
### obtener los datos
GET http://localhost:9000/api/schedules HTTP/1.1

### crear un horario
POST http://localhost:9000/api/schedules HTTP/1.1
Content-Type: application/json

{
    "horarioapertura": "09:00:00",
    "horariocierre": "18:00:00",
    "lunes": false,
    "martes": false,
    "miercoles": false,
    "jueves": false,
    "viernes": false,
    "sabado": true,
    "domingo": false
}
### Editar un horario con id
PUT http://localhost:9000/api/schedules/2
Content-Type: application/json

{
    "horarioapertura": "08:00:00",
    "horariocierre": "16:00:00",
    "lunes": false,
    "martes": false,
    "miercoles": false,
    "jueves": false,
    "viernes": true,
    "sabado": false,
    "domingo": false
}


### Eliminar horario
DELETE http://localhost:9000/api/schedules/2 HTTP/1.1


######## Dresssales / Venta #############################
### Obtener todas las ventas
GET http://localhost:9000/api/dresssales


### Obtener venta por ID
GET http://localhost:9000/api/dresssales/1


### Buscar por opción
GET http://localhost:9000/api/dresssaless/option/entregado

###
POST http://localhost:9000/api/dresssales HTTP/1.1
Content-Type: application/json

{
    "idvestido": 1,
    "idusuarioadmin": 1,
    "idusuariocliente": 1,
    "costoenvio": 2000.00,
    "diaenviar": "2026-11-11",
    "pagototal": 3000.00,
    "pais": "México",
    "estado": "Jalisco",
    "municipio": "Guadalajara",
    "direccion": "Av. Universidad #123",
    "estadoenviado": false
}

